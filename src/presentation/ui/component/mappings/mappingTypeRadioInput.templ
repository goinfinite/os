package componentMappings

import (
	"github.com/goinfinite/os/src/domain/valueObject"
	componentForm "github.com/goinfinite/os/src/presentation/ui/component/form"
	"golang.org/x/text/cases"
	"golang.org/x/text/language"
	uiDisplay "github.com/goinfinite/ui/src/display"
	"strings"
)

func transformMappingTypeIntoLabelFormat(mappingType string) string {
	typeWithoutHyphen := strings.ReplaceAll(mappingType, "-", " ")
	upperCaser := cases.Title(language.English)
	return upperCaser.String(typeWithoutHyphen)
}

templ MappingTypeRadioInput(id, label, bindModelPath string) {
	<!-- MappingTypeSelectInput -->
	<div class="-mb-3 -ml-1 flex justify-start gap-4">
		for _, mappingType := range valueObject.ValidMappingTargetTypes {
			@componentForm.RadioInput(
				"targetType", transformMappingTypeIntoLabelFormat(mappingType),
				mappingType, bindModelPath,
			)
		}
	</div>
	<div x-show={ bindModelPath + " == 'url'" }>
		@uiDisplay.Alert(uiDisplay.AlertSettings{
			Variation:   uiDisplay.AlertVariationInfo,
			Description: "Set up direct redirects to an URL, optionally with a custom HTTP response code.",
			Size:        uiDisplay.AlertSizeXs,
			IsCloseable: false,
		})
	</div>
	<div x-show={ bindModelPath + " == 'service'" }>
		@uiDisplay.Alert(uiDisplay.AlertSettings{
			Variation:   uiDisplay.AlertVariationInfo,
			Description: "Configure a service to handle the incoming requests, such as a web server, REST API, or a gRPC service.",
			Size:        uiDisplay.AlertSizeXs,
			IsCloseable: false,
		})
	</div>
	<div x-show={ bindModelPath + " == 'response-code'" }>
		@uiDisplay.Alert(uiDisplay.AlertSettings{
			Variation:   uiDisplay.AlertVariationInfo,
			Description: "Define custom responses for different HTTP status codes, such as 404 (Not Found) or 500 (Internal Server Error).",
			Size:        uiDisplay.AlertSizeXs,
			IsCloseable: false,
		})
	</div>
	<div x-show={ bindModelPath + " == 'inline-html'" }>
		@uiDisplay.Alert(uiDisplay.AlertSettings{
			Variation:   uiDisplay.AlertVariationInfo,
			Description: "Send a specific HTTP status code along with HTML content in the server's response.",
			Size:        uiDisplay.AlertSizeXs,
			IsCloseable: false,
		})
	</div>
	<div x-show={ bindModelPath + " == 'static-files'" }>
		@uiDisplay.Alert(uiDisplay.AlertSettings{
			Variation:   uiDisplay.AlertVariationInfo,
			Description: "URLs will act as file paths, serving static files from the specified directory.",
			Size:        uiDisplay.AlertSizeXs,
			IsCloseable: false,
		})
	</div>
}
