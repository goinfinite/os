package uiPresenter

import (
	_ "embed"
	componentForm "github.com/goinfinite/os/src/presentation/ui/component/form"
	componentStructural "github.com/goinfinite/os/src/presentation/ui/component/structural"
	uiToolset "github.com/goinfinite/ui/src/toolset"
)

//go:embed state.js
var terminalAlpineState string

templ TerminalDependencies() {
	<!-- TerminalDependencies -->
	<link
		rel="stylesheet"
		href="https://cdn.jsdelivr.net/npm/@xterm/xterm@6.0.0/css/xterm.css"
		integrity="sha256-hUp8D7cOixoIPBZ5ergnKZ+xh0T1rTTyJ7SDN+Myk8Y="
		crossorigin="anonymous"
	/>
	<script
		src="https://cdn.jsdelivr.net/npm/@xterm/xterm@6.0.0/lib/xterm.js"
		integrity="sha256-FJA1ef9UZkzXL46GmeaWGmJywhhj7Bw7EYzcivXUqXI="
		crossorigin="anonymous"
	></script>
	<script
		src="https://cdn.jsdelivr.net/npm/@xterm/addon-fit@0.11.0/lib/addon-fit.js"
		integrity="sha256-uj6iVs4GIKCZKhl9bJuupkgj/JPY2gep42bKmUPBhSc="
		crossorigin="anonymous"
	></script>
}

templ TerminalSessionsContent() {
	<!-- TerminalSessionsContent -->
	@uiToolset.MinifierTemplateJs(&terminalAlpineState)
	@TerminalDependencies()
	<div x-data="terminal" class="flex flex-col gap-4">
		<form class="flex flex-col gap-2 md:flex-row md:items-end" @submit.prevent="createSession()">
			<div class="grow">
				@componentForm.InputField(componentForm.InputFieldDto{
					Type:               "text",
					Id:                 "workingDir",
					Label:              "Working Directory",
					BindModelValuePath: "workingDir",
				})
			</div>
			<div class="grow">
				@componentForm.InputField(componentForm.InputFieldDto{
					Type:               "text",
					Id:                 "command",
					Label:              "Command (optional)",
					BindModelValuePath: "command",
				})
			</div>
			<div class="md:w-48">
				@componentForm.DeactivableSubmitButton(
					"create session", "ph-plus", "", "isLoading", false,
				)
			</div>
		</form>
		<div class="space-y-2">
			<template x-for="session in sessions" :key="session.id">
				<div class="flex flex-wrap items-center justify-between gap-2 rounded-md bg-neutral-500/5 p-2.5 text-sm">
					<div class="flex flex-wrap items-center gap-3">
						<span class="flex items-center gap-2 font-mono">
							<i class="ph-duotone ph-terminal-window text-lg"></i>
							<span x-text="session.id"></span>
						</span>
						<span class="text-neutral-400" x-text="session.accountUsername"></span>
						<span class="text-neutral-500" x-text="session.workingDir"></span>
						<span class="text-neutral-500" x-text="session.attachedClients + ' attached'"></span>
					</div>
					<div class="flex items-center gap-2">
						<button
							type="button"
							@click="openTab(session)"
							:disabled="isSessionAttached(session.id)"
							class="rounded-md border-none bg-infinite-500 px-2 py-1 text-sm font-bold lowercase text-white hover:bg-infinite-300 disabled:cursor-default disabled:opacity-50"
						>
							<i class="ph-bold ph-plug align-middle"></i>
							attach
						</button>
						<button
							type="button"
							@click="killSession(session.id)"
							class="rounded-md border-none bg-red-800 px-2 py-1 text-sm font-bold lowercase text-white hover:bg-red-600"
						>
							<i class="ph-bold ph-trash align-middle"></i>
							kill
						</button>
					</div>
				</div>
			</template>
			<template x-if="sessions.length === 0">
				<p class="py-2 text-center italic text-slate-500">No terminal sessions.</p>
			</template>
		</div>
		<div class="flex flex-wrap gap-1 border-b border-neutral-50/10" x-show="openTabs.length > 0">
			<template x-for="tab in openTabs" :key="tab.sessionId">
				<button
					type="button"
					@click="selectTab(tab.sessionId)"
					:class="activeTabId === tab.sessionId ? 'bg-os-300 text-neutral-50' : 'text-neutral-400'"
					class="flex items-center gap-2 rounded-t-md px-3 py-1.5 text-sm"
				>
					<span class="h-2 w-2 rounded-full" :class="tab.isConnected ? 'bg-emerald-500' : 'bg-red-600'"></span>
					<span x-text="tab.title"></span>
					<i class="ph-bold ph-x" @click.stop="closeTab(tab.sessionId)"></i>
				</button>
			</template>
		</div>
		<template x-for="tab in openTabs" :key="tab.sessionId">
			<div x-show="activeTabId === tab.sessionId" class="bg-os-950 h-96 w-full rounded-md p-2">
				<div :id="'terminal-' + tab.sessionId" class="h-full w-full"></div>
			</div>
		</template>
	</div>
}

templ TerminalIndex() {
	<!-- TerminalIndex HTML -->
	<div class="flex flex-col">
		@componentStructural.PageTitle(
			"Terminal",
			"Open persistent terminal sessions that run as your account. Sessions survive a browser close and an os-api restart.",
			"ph-terminal-window",
		)
		@TerminalSessionsContent()
	</div>
}
