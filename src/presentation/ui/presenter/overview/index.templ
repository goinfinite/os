package uiPresenter

import (
	_ "embed"
	"encoding/json"
	"fmt"
	"github.com/goinfinite/os/src/domain/dto"
	"github.com/goinfinite/os/src/domain/entity"
	"github.com/goinfinite/os/src/domain/valueObject"
	componentForm "github.com/goinfinite/os/src/presentation/ui/component/form"
	componentMisc "github.com/goinfinite/os/src/presentation/ui/component/misc"
	componentStructural "github.com/goinfinite/os/src/presentation/ui/component/structural"
	presenterHelper "github.com/goinfinite/os/src/presentation/ui/presenter/helper"
	presenterMarketplace "github.com/goinfinite/os/src/presentation/ui/presenter/marketplace"
	presenterTerminal "github.com/goinfinite/os/src/presentation/ui/presenter/terminal"
	tkDto "github.com/goinfinite/tk/src/domain/dto"
	uiControl "github.com/goinfinite/ui/src/control"
	uiDisplay "github.com/goinfinite/ui/src/display"
	uiForm "github.com/goinfinite/ui/src/form"
	uiStructural "github.com/goinfinite/ui/src/structural"
	"github.com/goinfinite/ui/src/toolset"
	"math"
	"strconv"
)

type InstallableServicesGroupedByType struct {
	Runtime   []entity.InstallableService
	Database  []entity.InstallableService
	Webserver []entity.InstallableService
	Other     []entity.InstallableService
}

type ServicesOverview struct {
	InstalledServicesResponseDto dto.ReadInstalledServicesItemsResponse
	InstallableServices          InstallableServicesGroupedByType
}

//go:embed state.js
var overviewIndexAlpineState string

templ OverviewIndex(
	vhostsHostnames []string,
	marketplaceOverview presenterMarketplace.MarketplaceOverview,
	o11yOverview entity.O11yOverview,
	servicesOverview ServicesOverview,
	terminalSessionsResponseDto dto.ReadTerminalSessionsResponse,
) {
	<!-- OverviewIndex JavaScript -->
	@uiToolset.MinifierTemplateJs(&overviewIndexAlpineState)
	@presenterMarketplace.MarketplaceAlpineState()
	@presenterTerminal.TerminalAlpineState()
	<!-- OverviewIndex HTML -->
	<div class="flex flex-col">
		@componentStructural.PageTitle(
			"Overview",
			"Welcome! Take a quick peek at your installed services and marketplace items, as well as OS performance such as the server resource usage and system information.",
			"ph-speedometer",
		)
		<div class="flex flex-col gap-5">
			<div class="grid grid-cols-1 items-start gap-5 lg:grid-cols-2">
				<div id="marketplace" x-data="marketplace">
					@uiStructural.Card(uiStructural.CardSettings{
						HeaderContent: componentStructural.PageSubHeading(
							"Marketplace", "", "ph-storefront",
						),
						MiddleContent: templ.Join(
							InstalledMarketplaceItemsDataTable(marketplaceOverview),
							uiDisplay.DeleteDialog(uiDisplay.ConfirmationDialogSettings{
								IsVisibleTwoWayStatePath: "isUninstallMarketplaceItemModalOpen",
								OnConfirmFunc:            "uninstallMarketplaceItem()",
								CancelButtonLabel:        "No, Keep it.",
								TargetNameStatePath:      "marketplaceItem.name",
								TargetIdStatePath:        "marketplaceItem.id",
								ConfirmButtonLabel:       "Yes, Schedule Delete!",
								ConfirmButtonIcon:        "ph-queue",
							}),
							ScheduleMarketplaceItemInstallationModal(
								vhostsHostnames, marketplaceOverview.CatalogItemsList,
							),
						),
					})
				</div>
				<div id="terminal-sessions" x-data="terminal">
					@uiStructural.Card(uiStructural.CardSettings{
						HeaderContent: componentStructural.PageSubHeading(
							"Terminal Sessions", "", "ph-terminal-window",
						),
						MiddleContent: TerminalSessionsDataTable(
							terminalSessionsResponseDto,
						),
					})
				</div>
			</div>
			<div id="services" x-data="services">
				@uiStructural.Card(uiStructural.CardSettings{
					HeaderContent: componentStructural.PageSubHeading(
						"Services", "", "ph-package",
					),
					MiddleContent: templ.Join(
						InstalledServicesDataTable(
							servicesOverview.InstalledServicesResponseDto,
						),
						ServiceInstallationModal(servicesOverview.InstallableServices),
						UpdateInstalledServiceModal(),
						uiDisplay.DeleteDialog(uiDisplay.ConfirmationDialogSettings{
							IsVisibleTwoWayStatePath: "isUninstallServiceModalOpen",
							OnConfirmFunc:            "uninstallService()",
							CancelButtonLabel:        "No, Keep it.",
							TargetNameStatePath:      "service.name",
						}),
					),
				})
			</div>
			<div class="grid grid-cols-1 items-start gap-5 lg:grid-cols-2">
				<div id="system-info">
					@uiStructural.Card(uiStructural.CardSettings{
						HeaderContent: componentStructural.PageSubHeading(
							"System Information", "", "ph-info",
						),
						MiddleContent: SystemInfoTable(o11yOverview),
					})
				</div>
				<div id="resource-usage" x-data="resourceUsage">
					@uiStructural.Card(uiStructural.CardSettings{
						HeaderContent: componentStructural.PageSubHeading(
							"Resource Usage", "", "ph-chart-line",
						),
						MiddleContent: ResourceUsageGraph(),
					})
				</div>
			</div>
		</div>
	</div>
}

templ DataTableTextCell(text string) {
	<span class="text-neutral-300">{ text }</span>
}

templ DataTableCarouselStyleEmptyState(
	icon, message, ctaLabel, ctaIcon, ctaOnClick string,
) {
	<div class="bg-neutral-950/20 mx-auto flex w-fit items-center gap-4 rounded-md p-4">
		<i class={ "ph-duotone " + icon + " text-3xl text-infinite-500" }></i>
		<div class="text-wrap max-w-56 break-words text-sm text-neutral-300">
			{ message }
		</div>
		<div class="shrink-0">
			@uiControl.Button(uiControl.ButtonSettings{
				Label:                ctaLabel,
				IconLeft:             ctaIcon,
				Size:                 uiControl.ButtonSizeSm,
				BackgroundColor:      "infinite-500",
				BackgroundColorHover: "infinite-300",
				OnClickFunc:          ctaOnClick,
			})
		</div>
	</div>
}

templ TerminalSessionNameCell(session entity.TerminalSession) {
	<template x-if={ "renamingSessionId !== '" + session.Id.String() + "'" }>
		<div class="flex flex-col gap-1">
			<span class="font-medium text-neutral-100">{ session.ReadName() }</span>
			<span class="font-mono text-xs italic text-neutral-500">{ session.Id.String() }</span>
			@uiDisplay.Tag(uiDisplay.TagSettings{
				Size:                 uiDisplay.TagSizeXs,
				OuterBackgroundColor: "infinite-800",
				OuterLeftLabel:       "path",
				OuterRadius:          uiToolset.BorderRadiusXl,
				InnerLabel:           session.WorkingDir.String(),
				InnerRadius:          uiToolset.BorderRadiusXl,
			})
		</div>
	</template>
	<template x-if={ "renamingSessionId === '" + session.Id.String() + "'" }>
		@presenterTerminal.TerminalSessionRenameInput(
			"submitRename('" + session.Id.String() + "')",
		)
	</template>
}

func terminalSessionRenameOnClickResolver(session entity.TerminalSession) string {
	currentName := ""
	if session.Name != nil {
		currentName = session.Name.String()
	}
	currentNameJson, _ := json.Marshal(currentName)

	return "startRename('" + session.Id.String() + "', " + string(currentNameJson) + ")"
}

templ TerminalSessionActionsCell(session entity.TerminalSession) {
	<div class="flex items-center justify-end gap-2">
		@uiControl.Button(uiControl.ButtonSettings{
			IconLeft:               "ph-plug",
			Shape:                  uiToolset.ShapeCircular,
			Size:                   uiControl.ButtonSizeSm,
			BackgroundColor:        "cyan-900",
			BackgroundColorHover:   "cyan-700",
			OnClickFunc:            "openTerminalSession('" + session.Id.String() + "')",
			AriaLabel:              "Attach",
			TooltipContent:         "Attach",
			TooltipBackgroundColor: "cyan-700",
		})
		@uiControl.Button(uiControl.ButtonSettings{
			IconLeft:               "ph-pencil-simple",
			Shape:                  uiToolset.ShapeCircular,
			Size:                   uiControl.ButtonSizeSm,
			BackgroundColor:        "os-200",
			BackgroundColorHover:   "os-300",
			OnClickFunc:            terminalSessionRenameOnClickResolver(session),
			AriaLabel:              "Rename",
			TooltipContent:         "Rename",
			TooltipBackgroundColor: "os-200",
		})
		@uiControl.Button(uiControl.ButtonSettings{
			IconLeft:               "ph-trash",
			Shape:                  uiToolset.ShapeCircular,
			Size:                   uiControl.ButtonSizeSm,
			BackgroundColor:        "red-800",
			BackgroundColorHover:   "red-600",
			OnClickFunc:            "killSession('" + session.Id.String() + "')",
			AriaLabel:              "Kill",
			TooltipContent:         "Kill",
			TooltipBackgroundColor: "red-500",
		})
	</div>
}

func terminalSessionsTableSettingsBuilder(
	responseDto dto.ReadTerminalSessionsResponse,
) uiStructural.DataTableSettings[entity.TerminalSession] {
	paginationSettings := presenterHelper.DataTablePaginationSettingsResolver(
		responseDto.Pagination,
	)

	return uiStructural.DataTableSettings[entity.TerminalSession]{
		Columns: []uiStructural.DataTableColumnSettings[entity.TerminalSession]{
			{
				Label:        "Name",
				SortKey:      "name",
				WidthPercent: 45,
				CellRenderer: func(session entity.TerminalSession) templ.Component {
					return TerminalSessionNameCell(session)
				},
			},
			{
				Label:        "Attached",
				Alignment:    uiStructural.TextAlignmentCenter,
				WidthPercent: 15,
				CellRenderer: func(session entity.TerminalSession) templ.Component {
					return DataTableTextCell(strconv.Itoa(int(session.AttachedClients)))
				},
			},
			{
				Label:        "Created At",
				SortKey:      "createdAt",
				WidthPercent: 20,
				CellRenderer: func(session entity.TerminalSession) templ.Component {
					return DataTableTextCell(session.CreatedAt.ReadDateOnly())
				},
			},
			{
				Label:        "",
				Alignment:    uiStructural.TextAlignmentRight,
				WidthPercent: 20,
				CellRenderer: func(session entity.TerminalSession) templ.Component {
					return TerminalSessionActionsCell(session)
				},
			},
		},
		Rows:                 responseDto.TerminalSessions,
		ItemsTotal:           paginationSettings.ItemsTotal,
		PagesTotal:           paginationSettings.PagesTotal,
		InitialSortKey:       paginationSettings.SortKey,
		InitialSortDirection: paginationSettings.SortDirection,
		Id:                   "terminal-sessions-table",
		IsStriped:            true,
		EmptyState: DataTableCarouselStyleEmptyState(
			"ph-terminal-window",
			"Open a terminal session and run commands with one-click.",
			"new session", "ph-plus", "createSessionWithDefaults()",
		),
		PageNumber:   paginationSettings.PageNumber,
		ItemsPerPage: uiStructural.ItemsPerPage(paginationSettings.ItemsPerPage),
		ItemsPerPageDropdownBackgroundColor: "primary-500/95",
		QueryUrlTemplate: "fragment/overview/terminal-sessions-table/?" +
			"pageNumber=" + uiStructural.DataTableUrlPlaceholderPageNumber +
			"&itemsPerPage=" + uiStructural.DataTableUrlPlaceholderItemsPerPage +
			"&sortBy=" + uiStructural.DataTableUrlPlaceholderSortKey +
			"&sortDirection=" + uiStructural.DataTableUrlPlaceholderSortDirection,
		RefreshOnEvents: []string{"update:terminal-session"},
		HeaderActions: uiControl.Button(uiControl.ButtonSettings{
			Label:                "new session",
			IconLeft:             "ph-plus",
			Size:                 uiControl.ButtonSizeSm,
			BackgroundColor:      "infinite-500",
			BackgroundColorHover: "infinite-300",
			OnClickFunc:          "createSessionWithDefaults()",
		}),
	}
}

templ TerminalSessionsDataTable(responseDto dto.ReadTerminalSessionsResponse) {
	@uiStructural.DataTable(terminalSessionsTableSettingsBuilder(responseDto))
}

templ MarketplaceInstalledItemNameCell(installedItem entity.MarketplaceInstalledItem) {
	<div class="flex items-center gap-2">
		<img class="h-10 w-10 rounded-full" src={ installedItem.AvatarUrl.String() }/>
		{ installedItem.Name.String() }
	</div>
}

templ MarketplaceInstalledItemActionsCell(installedItem entity.MarketplaceInstalledItem) {
	<div class="flex items-center justify-end">
		@templ.JSONScript("installedMarketplaceItem_"+installedItem.Id.String(), installedItem)
		@uiControl.Button(uiControl.ButtonSettings{
			IconLeft:               "ph-trash",
			Shape:                  uiToolset.ShapeCircular,
			Size:                   uiControl.ButtonSizeSm,
			BackgroundColor:        "red-800",
			BackgroundColorHover:   "red-600",
			OnClickFunc:            "openUninstallMarketplaceItemModal('" + installedItem.Id.String() + "')",
			AriaLabel:              "Uninstall",
			TooltipContent:         "Uninstall",
			TooltipBackgroundColor: "red-500",
		})
	</div>
}

func marketplaceItemsTableSettingsBuilder(
	installedItemsList []entity.MarketplaceInstalledItem,
	pagination tkDto.Pagination,
) uiStructural.DataTableSettings[entity.MarketplaceInstalledItem] {
	paginationSettings := presenterHelper.DataTablePaginationSettingsResolver(pagination)

	return uiStructural.DataTableSettings[entity.MarketplaceInstalledItem]{
		Columns: []uiStructural.DataTableColumnSettings[entity.MarketplaceInstalledItem]{
			{
				Label:        "Name",
				SortKey:      "name",
				WidthPercent: 30,
				Alignment:    uiStructural.TextAlignmentLeft,
				CellRenderer: func(
					installedItem entity.MarketplaceInstalledItem,
				) templ.Component {
					return MarketplaceInstalledItemNameCell(installedItem)
				},
			},
			{
				Label:        "Type/Installation Path",
				SortKey:      "type",
				WidthPercent: 25,
				CellRenderer: func(
					installedItem entity.MarketplaceInstalledItem,
				) templ.Component {
					return uiDisplay.Tag(uiDisplay.TagSettings{
						Size:                 uiDisplay.TagSizeXs,
						OuterBackgroundColor: "infinite-800",
						OuterLeftLabel:       installedItem.Type.String(),
						OuterRadius:          uiToolset.BorderRadiusXl,
						InnerLabel: installedItem.Hostname.String() +
							installedItem.UrlPath.String(),
						InnerRadius: uiToolset.BorderRadiusXl,
					})
				},
			},
			{
				Label:        "Installation Directory",
				WidthPercent: 20,
				CellRenderer: func(
					installedItem entity.MarketplaceInstalledItem,
				) templ.Component {
					return DataTableTextCell(installedItem.InstallDirectory.String())
				},
			},
			{
				Label:        "Created At",
				SortKey:      "createdAt",
				WidthPercent: 15,
				CellRenderer: func(
					installedItem entity.MarketplaceInstalledItem,
				) templ.Component {
					return DataTableTextCell(installedItem.CreatedAt.ReadDateOnly())
				},
			},
			{
				Label:        "",
				Alignment:    uiStructural.TextAlignmentRight,
				WidthPercent: 10,
				CellRenderer: func(
					installedItem entity.MarketplaceInstalledItem,
				) templ.Component {
					return MarketplaceInstalledItemActionsCell(installedItem)
				},
			},
		},
		Rows:                 installedItemsList,
		ItemsTotal:           paginationSettings.ItemsTotal,
		PagesTotal:           paginationSettings.PagesTotal,
		InitialSortKey:       paginationSettings.SortKey,
		InitialSortDirection: paginationSettings.SortDirection,
		Id:                   "marketplace-items-table",
		IsStriped:            true,
		EmptyState: DataTableCarouselStyleEmptyState(
			"ph-storefront",
			"Install your favorite app/platform with one-click.",
			"install catalog item", "ph-arrow-line-down",
			"openMarketplaceItemInstallationModal()",
		),
		PageNumber:   paginationSettings.PageNumber,
		ItemsPerPage: uiStructural.ItemsPerPage(paginationSettings.ItemsPerPage),
		ItemsPerPageDropdownBackgroundColor: "primary-500/95",
		QueryUrlTemplate: "fragment/overview/marketplace-table/?" +
			"pageNumber=" + uiStructural.DataTableUrlPlaceholderPageNumber +
			"&itemsPerPage=" + uiStructural.DataTableUrlPlaceholderItemsPerPage +
			"&sortBy=" + uiStructural.DataTableUrlPlaceholderSortKey +
			"&sortDirection=" + uiStructural.DataTableUrlPlaceholderSortDirection,
		RefreshOnEvents: []string{"uninstall:marketplace-item"},
		HeaderActions: componentForm.SubmitButton(
			"", "install catalog item", "ph-arrow-line-down",
			"openMarketplaceItemInstallationModal()", true,
		),
	}
}

templ InstalledMarketplaceItemsDataTable(
	marketplaceOverview presenterMarketplace.MarketplaceOverview,
) {
	@uiStructural.DataTable(marketplaceItemsTableSettingsBuilder(
		marketplaceOverview.InstalledItemsList, marketplaceOverview.InstalledItemsPagination,
	))
}

templ CarouselItemHoverCard(description, icon, estimatedSize string) {
	<!-- CarouselItemHoverCard -->
	<template x-teleport="body">
		<div
			x-ref="tooltip"
			role="tooltip"
			:style="resolvedTooltipStyle"
			class="bg-os-600 pointer-events-none invisible fixed z-100 w-100 rounded-md p-3 text-xs text-neutral-50 opacity-0 shadow-lg transition-opacity duration-150"
		>
			<div class="flex flex-row items-center gap-3">
				<div class="basis-3/4 text-xs">{ description }</div>
				<div class="basis-1/4 space-y-1.5">
					@uiDisplay.Tag(uiDisplay.TagSettings{
						Size:                 uiDisplay.TagSizeXs,
						OuterBackgroundColor: "infinite-800",
						OuterLeftIcon:        icon,
						OuterRadius:          uiToolset.BorderRadiusXl,
						InnerLabel:           estimatedSize,
						InnerRadius:          uiToolset.BorderRadiusXl,
					})
				</div>
			</div>
		</div>
	</template>
}

templ MarketplaceCatalogItemsCarousel(catalogItemEntity entity.MarketplaceCatalogItem) {
	<div>
		<!-- MarketplaceCatalogItemsCarousel JavaScript -->
		@templ.JSONScript("marketplaceCatalogItem_"+catalogItemEntity.Id.String(), catalogItemEntity)
		<!-- MarketplaceCatalogItemsCarousel HTML -->
		<div
			x-data="carouselItemTooltip"
			@mouseenter="showTooltip()"
			@mouseleave="hideTooltip()"
			@click={ "updateSelectedMarketplaceItem(" + catalogItemEntity.Id.String() + ")" }
			class="bg-os-500 hover:ring-infinite-500 hover:text-infinite-500 group flex cursor-pointer flex-col items-center justify-center rounded-md p-2 transition-all duration-300 hover:ring-1"
			:class={ "{'text-infinite-500 ring-1 ring-infinite-500': selectedMarketplaceItemId === " + catalogItemEntity.Id.String() + "}" }
		>
			<img
				alt={ catalogItemEntity.Name.String() + " Avatar" }
				class="max-w-18 m-auto rounded-md transition-all duration-300 group-hover:sepia"
				:class={ "{'sepia': selectedMarketplaceItemId === " + catalogItemEntity.Id.String() + "}" }
				x-intersect.once={ "$el.src = '" + catalogItemEntity.AvatarUrl.String() + "'" }
				src="assets/placeholder-100x100.svg"
				x-transition
			/>
			<div class="text-wrap mt-1 break-words text-center text-xs">
				{ catalogItemEntity.Name.String() }
			</div>
			@CarouselItemHoverCard(
				catalogItemEntity.Description.String(),
				"ph-hard-drives",
				catalogItemEntity.EstimatedSizeBytes.StringWithSuffix(),
			)
		</div>
	</div>
}

func transformMarketplaceCatalogItemsIntoCarouselItems(
	catalogItems []entity.MarketplaceCatalogItem,
) []templ.Component {
	carouselItems := []templ.Component{}
	for _, itemEntity := range catalogItems {
		carouselItem := MarketplaceCatalogItemsCarousel(itemEntity)
		carouselItems = append(carouselItems, carouselItem)
	}

	return carouselItems
}

templ ScheduleMarketplaceItemInstallationParameters() {
	@uiDisplay.Alert(uiDisplay.AlertSettings{
		Variation:   uiDisplay.AlertVariationWarning,
		Description: "All fields without pre-filled values must be completed as they are required. Otherwise, the installation will fail!",
		Size:        uiDisplay.AlertSizeXs,
		IsCloseable: false,
	})
	<div class="grid grid-cols-2 gap-4">
		<template x-for="dataField in marketplaceItem.dataFields">
			<div>
				<template x-if="dataField.type === 'text' || dataField.type === 'email'">
					@componentForm.InputFieldClientSide(
						"dataField.type", "dataField.label", "dataField.value",
					)
				</template>
				<template x-if="dataField.type === 'password'">
					@componentForm.PasswordInputClientSide(
						"dataField.label", "dataField.value", true,
					)
				</template>
				<template x-if="dataField.type === 'select'">
					@componentForm.SelectInputClientSide(componentForm.SelectInputClientSideDto{
						BindLabel:     "dataField.label",
						BindModelPath: "dataField.value",
						BindOptions:   "dataField.options",
					})
				</template>
			</div>
		</template>
	</div>
}

templ ScheduleMarketplaceItemInstallationForm(
	vhostsHostnames []string,
	marketplaceCatalogItems presenterMarketplace.CatalogItemsGroupedByType,
) {
	<!-- ScheduleMarketplaceItemInstallationForm -->
	<form
		id="schedule-marketplace-item-installation-form"
		hx-post="api/v1/marketplace/catalog/"
		hx-indicator="#loading-overlay"
		hx-swap="none"
		@submit="$store.main.refreshScheduledTasksPopover()"
	>
		<input type="hidden" name="id" :value="marketplaceItem.id"/>
		<input type="hidden" name="dataFields" :value="dataFieldsAsString"/>
		@templ.JSONScript("marketplaceInstallVhostHostnames", vhostsHostnames)
		<div class="mt-3 mb-6 space-y-2">
			<div class="w-100% inline-flex space-x-2">
				<div class="w-60%">
					@uiForm.SelectInput(uiForm.SelectInputSettings{
						InputName:                "hostname",
						Label:                    "Hostname",
						FlatOptions:              vhostsHostnames,
						TwoWayStatePath:          "marketplaceItem.hostname",
						Size:                     uiForm.SelectInputSizeLg,
						ShouldIncludeBlankOption: true,
						DropdownBackgroundColor:  "primary-500/95",
					})
				</div>
				<div class="w-40%">
					@uiForm.InputField(uiForm.InputFieldSettings{
						InputType:          uiForm.InputTypeText,
						InputName:          "urlPath",
						Label:              "URL Path",
						TwoWayStatePath:    "marketplaceItem.urlPath",
						AffixLeftStatePath: "hostnameWithTrailingSlash",
						HintValue:          "Path where the respective installed item will be available for access.",
						HintDisplay:        uiForm.InputHintDisplayTooltip,
						Size:               uiForm.InputFieldSizeLg,
					})
				</div>
			</div>
			<div class="bg-neutral-950/20 flex flex-col gap-4 rounded-md p-3">
				<div class="flex justify-stretch gap-4">
					<div>
						@componentStructural.VerticalTabHeader(
							[]componentStructural.TabHeaderItem{
								{Label: "Apps", Value: "apps"},
								{Label: "Frameworks", Value: "frameworks"},
								{Label: "Stacks", Value: "stacks"},
							}, "selectedMarketplaceItemType",
						)
					</div>
					<!-- MarketplaceVerticalTabContent -->
					<div class="bg-os-400 flex w-full justify-center rounded-lg px-5 py-2.5">
						<div x-show="selectedMarketplaceItemType === 'apps'">
							@componentMisc.MultiItemCarousel(
								"marketplaceAppItemsCarousel",
								transformMarketplaceCatalogItemsIntoCarouselItems(marketplaceCatalogItems.Apps),
								4,
							)
						</div>
						<div x-show="selectedMarketplaceItemType === 'frameworks'">
							@componentMisc.MultiItemCarousel(
								"marketplaceFrameworksItemsCarousel",
								transformMarketplaceCatalogItemsIntoCarouselItems(marketplaceCatalogItems.Frameworks),
								4,
							)
						</div>
						<div x-show="selectedMarketplaceItemType === 'stacks'">
							@componentMisc.MultiItemCarousel(
								"marketplaceStacksItemsCarousel",
								transformMarketplaceCatalogItemsIntoCarouselItems(marketplaceCatalogItems.Stacks),
								4,
							)
						</div>
					</div>
				</div>
			</div>
			<template x-if="marketplaceItem.id !== ''">
				@uiDisplay.Accordion(uiDisplay.AccordionSettings{
					Items: []uiDisplay.AccordionItemSettings{
						{
							Title:   "Install Parameters",
							Icon:    "ph-brackets-curly",
							Content: ScheduleMarketplaceItemInstallationParameters(),
						},
					},
					BackgroundColor:        "neutral-950/20",
					OpenBackgroundColor:    "neutral-950/30",
					ContentBackgroundColor: "os-400",
				})
			</template>
		</div>
		@componentForm.SubmitButton(
			"install-marketplace-item-button", "schedule installation",
			"ph-queue", "closeMarketplaceItemInstallationModal()", false,
		)
	</form>
}

templ ScheduleMarketplaceItemInstallationModal(
	vhostsHostnames []string,
	marketplaceCatalogItems presenterMarketplace.CatalogItemsGroupedByType,
) {
	@uiDisplay.Modal(uiDisplay.ModalSettings{
		MiddleContent:            ScheduleMarketplaceItemInstallationForm(vhostsHostnames, marketplaceCatalogItems),
		Title:                    "Install Marketplace Item",
		BackgroundColor:          "os-400",
		ShouldHeightMatchContent: true,
		IsVisibleTwoWayStatePath: "isMarketplaceItemInstallationModalOpen",
		OnCloseFunc:              "closeMarketplaceItemInstallationModal()",
	})
}

func transformUptimeSecsIntoHumanReadable(uptimeSecs uint64) string {
	uptimeHours := uptimeSecs / 3600
	uptimeMinutes := (uptimeSecs % 3600) / 60
	uptimeSeconds := uptimeSecs % 60

	return fmt.Sprintf("%dh %dm %ds", uptimeHours, uptimeMinutes, uptimeSeconds)
}

func transformCpuInfoIntoHumanReadable(cpuCores float64, cpuFrequency float64) string {
	cpuFrequency = math.Round(cpuFrequency/1000*10) / 10
	return fmt.Sprintf("%.0f CPU @ %.1f GHz", cpuCores, cpuFrequency)
}

templ SystemInfoTable(o11yOverview entity.O11yOverview) {
	<!-- SystemInfoTable -->
	<div class="*:text-sm *:rounded-md *:p-2.5 *:flex *:justify-between *:bg-neutral-500/5 *:items-center flex flex-col space-y-2 rounded-lg p-3">
		<div>
			<span class="font-bold">Hostname</span>
			<span class="text-right">{ o11yOverview.Hostname.String() }</span>
		</div>
		<div>
			<span class="font-bold">Uptime</span>
			<span class="text-right">{ transformUptimeSecsIntoHumanReadable(o11yOverview.UptimeSecs) }</span>
		</div>
		<div>
			<span class="font-bold">Hardware Specs</span>
			<div class="space-y-2">
				<div class="flex justify-end">
					@uiDisplay.Tag(uiDisplay.TagSettings{
						Size:                 uiDisplay.TagSizeXs,
						OuterBackgroundColor: "infinite-800",
						OuterLeftIcon:        "ph-memory",
						OuterRadius:          uiToolset.BorderRadiusXl,
						InnerLabel:           o11yOverview.HardwareSpecs.MemoryTotal.StringWithSuffix() + " RAM",
						InnerRadius:          uiToolset.BorderRadiusXl,
					})
				</div>
				<div class="flex justify-end">
					@uiDisplay.Tag(uiDisplay.TagSettings{
						Size:                 uiDisplay.TagSizeXs,
						OuterBackgroundColor: "infinite-800",
						OuterLeftIcon:        "ph-cpu",
						OuterRadius:          uiToolset.BorderRadiusXl,
						InnerLabel:           transformCpuInfoIntoHumanReadable(o11yOverview.HardwareSpecs.CpuCores, o11yOverview.HardwareSpecs.CpuFrequency),
						InnerRadius:          uiToolset.BorderRadiusXl,
					})
				</div>
				<div class="flex justify-end">
					@uiDisplay.Tag(uiDisplay.TagSettings{
						Size:                 uiDisplay.TagSizeXs,
						OuterBackgroundColor: "infinite-800",
						OuterLeftIcon:        "ph-sim-card",
						OuterRadius:          uiToolset.BorderRadiusXl,
						InnerLabel:           o11yOverview.HardwareSpecs.StorageTotal.StringWithSuffix() + " Storage",
						InnerRadius:          uiToolset.BorderRadiusXl,
					})
				</div>
			</div>
		</div>
		<div>
			<span class="font-bold">Public IP Address</span>
			<span class="text-right">{ o11yOverview.PublicIpAddress.String() }</span>
		</div>
	</div>
}

