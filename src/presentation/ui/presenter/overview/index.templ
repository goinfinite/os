templ InstalledServiceNameCell(
	installedServiceEntity dto.InstalledServiceWithMetrics,
) {
	@templ.JSONScript(
		"installedServiceEntity_"+installedServiceEntity.Name.String(),
		installedServiceEntity,
	)
	<div class="flex items-center gap-2">
		<img
			class="h-8 w-8 rounded-full"
			if installedServiceEntity.AvatarUrl != nil {
				src={ installedServiceEntity.AvatarUrl.String() }
			} else {
				src="assets/default-avatar.jpg"
			}
		/>
		{ installedServiceEntity.Name.String() }
	</div>
	<div class="mt-1 flex flex-wrap items-center justify-normal gap-1.5">
		@uiDisplay.Tag(uiDisplay.TagSettings{
			Size:                 uiDisplay.TagSizeXs,
			OuterBackgroundColor: "infinite-800",
			OuterLeftLabel:       "type",
			OuterRadius:          uiToolset.BorderRadiusXl,
			InnerLabel:           installedServiceEntity.Type.String(),
			InnerRadius:          uiToolset.BorderRadiusXl,
		})
		@uiDisplay.Tag(uiDisplay.TagSettings{
			Size:                 uiDisplay.TagSizeXs,
			OuterBackgroundColor: "infinite-800",
			OuterLeftLabel:       "version",
			OuterRadius:          uiToolset.BorderRadiusXl,
			InnerLabel:           installedServiceEntity.Version.String(),
			InnerRadius:          uiToolset.BorderRadiusXl,
		})
		@uiDisplay.Tag(uiDisplay.TagSettings{
			Size:                 uiDisplay.TagSizeXs,
			OuterBackgroundColor: "infinite-800",
			OuterLeftLabel:       "nature",
			OuterRadius:          uiToolset.BorderRadiusXl,
			InnerLabel:           installedServiceEntity.Nature.String(),
			InnerRadius:          uiToolset.BorderRadiusXl,
		})
	</div>
}

templ InstalledServiceMetricsCell(usagePercentPtr *float64) {
	if usagePercentPtr == nil {
		<span class="text-center text-slate-500">--</span>
	} else {
		@componentMisc.ProgressBar(componentMisc.ProgressBarInputDto{
			ComponentColor:       "os-950",
			CompletionRate:       uint8(*usagePercentPtr),
			Label:                fmt.Sprintf("%.2f", *usagePercentPtr) + "%",
			LabelBackgroundColor: "os-200",
		})
	}
}

templ InstalledServiceActionsCell(
	installedServiceEntity dto.InstalledServiceWithMetrics,
) {
	<div class="flex justify-end space-x-2">
		@uiControl.Button(uiControl.ButtonSettings{
			IconLeft:               "ph-arrow-clockwise",
			Shape:                  uiToolset.ShapeCircular,
			Size:                   uiControl.ButtonSizeSm,
			BackgroundColor:        "os-200",
			BackgroundColorHover:   "os-300",
			OnClickFunc:            "updateServiceStatus('" + installedServiceEntity.Name.String() + "', 'restart')",
			AriaLabel:              "Restart",
			TooltipContent:         "Restart",
			TooltipBackgroundColor: "os-200",
		})
		if installedServiceEntity.Type != valueObject.ServiceTypeSystem {
			switch installedServiceEntity.Status {
				case valueObject.ServiceStatusRunning:
					@uiControl.Button(uiControl.ButtonSettings{
						IconLeft:               "ph-pause",
						Shape:                  uiToolset.ShapeCircular,
						Size:                   uiControl.ButtonSizeSm,
						BackgroundColor:        "yellow-900",
						BackgroundColorHover:   "yellow-700",
						OnClickFunc:            "updateServiceStatus('" + installedServiceEntity.Name.String() + "', 'pause')",
						AriaLabel:              "Pause",
						TooltipContent:         "Pause",
						TooltipBackgroundColor: "yellow-700",
					})
				case valueObject.ServiceStatusStopped:
					@uiControl.Button(uiControl.ButtonSettings{
						IconLeft:               "ph-play",
						Shape:                  uiToolset.ShapeCircular,
						Size:                   uiControl.ButtonSizeSm,
						BackgroundColor:        "cyan-900",
						BackgroundColorHover:   "cyan-700",
						OnClickFunc:            "updateServiceStatus('" + installedServiceEntity.Name.String() + "', 'start')",
						AriaLabel:              "Start",
						TooltipContent:         "Start",
						TooltipBackgroundColor: "cyan-700",
					})
			}
			if installedServiceEntity.Nature != valueObject.ServiceNatureSolo {
				@uiControl.Button(uiControl.ButtonSettings{
					IconLeft:               "ph-gear",
					Shape:                  uiToolset.ShapeCircular,
					Size:                   uiControl.ButtonSizeSm,
					BackgroundColor:        "os-200",
					BackgroundColorHover:   "os-300",
					OnClickFunc:            "openUpdateInstalledServiceModal('" + installedServiceEntity.Name.String() + "')",
					AriaLabel:              "Edit",
					TooltipContent:         "Edit",
					TooltipBackgroundColor: "os-200",
				})
			}
			@uiControl.Button(uiControl.ButtonSettings{
				IconLeft:               "ph-trash",
				Shape:                  uiToolset.ShapeCircular,
				Size:                   uiControl.ButtonSizeSm,
				BackgroundColor:        "red-800",
				BackgroundColorHover:   "red-600",
				OnClickFunc:            "openUninstallServiceModal('" + installedServiceEntity.Name.String() + "')",
				AriaLabel:              "Uninstall",
				TooltipContent:         "Uninstall",
				TooltipBackgroundColor: "red-500",
			})
		}
	</div>
}

func installedServicesTableSettingsBuilder(
	responseDto dto.ReadInstalledServicesItemsResponse,
) uiStructural.DataTableSettings[dto.InstalledServiceWithMetrics] {
	paginationSettings := presenterHelper.DataTablePaginationSettingsResolver(
		responseDto.Pagination,
	)

	typeFilterOptions := []uiForm.SelectLabelValueOption{
		{Label: "system", Value: "system"},
		{Label: "database", Value: "database"},
		{Label: "runtime", Value: "runtime"},
		{Label: "webserver", Value: "webserver"},
		{Label: "other", Value: "other"},
	}
	natureFilterOptions := []uiForm.SelectLabelValueOption{
		{Label: "solo", Value: "solo"},
		{Label: "multi", Value: "multi"},
		{Label: "custom", Value: "custom"},
	}
	statusFilterOptions := []uiForm.SelectLabelValueOption{
		{Label: "running", Value: "running"},
		{Label: "stopped", Value: "stopped"},
		{Label: "restarting", Value: "restarting"},
		{Label: "uninstalled", Value: "uninstalled"},
	}

	return uiStructural.DataTableSettings[dto.InstalledServiceWithMetrics]{
		Columns: []uiStructural.DataTableColumnSettings[dto.InstalledServiceWithMetrics]{
			{
				Label:        "Service",
				SortKey:      "name",
				WidthPercent: 30,
				Alignment:    uiStructural.TextAlignmentLeft,
				CellRenderer: func(
					installedServiceEntity dto.InstalledServiceWithMetrics,
				) templ.Component {
					return InstalledServiceNameCell(installedServiceEntity)
				},
			},
			{
				Label:        "Status",
				WidthPercent: 8,
				CellRenderer: func(
					installedServiceEntity dto.InstalledServiceWithMetrics,
				) templ.Component {
					return DataTableTextCell(installedServiceEntity.Status.String())
				},
			},
			{
				Label:        "CPU",
				WidthPercent: 8,
				CellRenderer: func(
					installedServiceEntity dto.InstalledServiceWithMetrics,
				) templ.Component {
					if installedServiceEntity.Metrics == nil {
						return InstalledServiceMetricsCell(nil)
					}
					return InstalledServiceMetricsCell(
						&installedServiceEntity.Metrics.CpuUsagePercent,
					)
				},
			},
			{
				Label:        "RAM",
				WidthPercent: 8,
				CellRenderer: func(
					installedServiceEntity dto.InstalledServiceWithMetrics,
				) templ.Component {
					if installedServiceEntity.Metrics == nil {
						return InstalledServiceMetricsCell(nil)
					}
					memoryUsagePercent := float64(
						installedServiceEntity.Metrics.MemUsagePercent,
					)
					return InstalledServiceMetricsCell(&memoryUsagePercent)
				},
			},
			{
				Label:        "Port Bindings",
				WidthPercent: 18,
				CellRenderer: func(
					installedServiceEntity dto.InstalledServiceWithMetrics,
				) templ.Component {
					if installedServiceEntity.PortBindings == nil ||
						len(installedServiceEntity.PortBindings) == 0 {
						return DataTableTextCell("--")
					}
					return componentStructural.PortBindingsTable(
						installedServiceEntity.PortBindings,
					)
				},
			},
			{
				Label:        "",
				Alignment:    uiStructural.TextAlignmentRight,
				WidthPercent: 28,
				CellRenderer: func(
					installedServiceEntity dto.InstalledServiceWithMetrics,
				) templ.Component {
					return InstalledServiceActionsCell(installedServiceEntity)
				},
			},
		},
		Rows:                 responseDto.InstalledServicesWithMetrics,
		ItemsTotal:           paginationSettings.ItemsTotal,
		PagesTotal:           paginationSettings.PagesTotal,
		InitialSortKey:       paginationSettings.SortKey,
		InitialSortDirection: paginationSettings.SortDirection,
		Id:                   "installed-services-table",
		IsStriped:            true,
		Density:              uiStructural.DataTableDensityDense,
		PageNumber:           paginationSettings.PageNumber,
		ItemsPerPage:         uiStructural.ItemsPerPage(paginationSettings.ItemsPerPage),
		Filters: []uiStructural.FilterSettings{
			{
				Key:   "name",
				Label: "Name",
				Kind:  uiStructural.FilterKindTextContains,
			},
			{
				Key:     "type",
				Label:   "Type",
				Kind:    uiStructural.FilterKindEnumSelect,
				Options: typeFilterOptions,
			},
			{
				Key:     "nature",
				Label:   "Nature",
				Kind:    uiStructural.FilterKindEnumSelect,
				Options: natureFilterOptions,
			},
			{
				Key:     "status",
				Label:   "Status",
				Kind:    uiStructural.FilterKindEnumSelect,
				Options: statusFilterOptions,
			},
		},
		FilterDropdownBackgroundColor: "primary-500/95",
		ItemsPerPageDropdownBackgroundColor: "primary-500/95",
		FilterChipStyle: uiStructural.FilterChipStyle{
			TextCase:             uiToolset.TextCaseLower,
			OuterBackgroundColor: "secondary-950",
			OuterRingColor:       "secondary-800",
			OuterTextColor:       "neutral-50",
			InnerBackgroundColor: "secondary-900",
			InnerTextColor:       "neutral-50",
		},
		QueryUrlTemplate: "fragment/overview/services-table/?" +
			"pageNumber=" + uiStructural.DataTableUrlPlaceholderPageNumber +
			"&itemsPerPage=" + uiStructural.DataTableUrlPlaceholderItemsPerPage +
			"&sortBy=" + uiStructural.DataTableUrlPlaceholderSortKey +
			"&sortDirection=" + uiStructural.DataTableUrlPlaceholderSortDirection,
		RefreshOnEvents: []string{
			"install:custom-service", "update:service", "delete:service",
		},
		HeaderActions: componentForm.SubmitButton(
			"", "install service", "ph-arrow-line-down",
			"openServiceInstallationModal()", true,
		),
	}
}

templ InstalledServicesDataTable(
	installedServicesResponseDto dto.ReadInstalledServicesItemsResponse,
) {
	@uiStructural.DataTable(installedServicesTableSettingsBuilder(installedServicesResponseDto))
}

templ InstallableServiceItemsCarousel(installableServiceEntity entity.InstallableService) {
	<div>
		<!-- InstallableServicesCarousel JavaScript -->
		@templ.JSONScript("installableServiceEntity_"+installableServiceEntity.Name.String(), installableServiceEntity)
		<!-- InstallableServicesCarousel HTML -->
		<div
			x-data="carouselItemTooltip"
			@mouseenter="showTooltip()"
			@mouseleave="hideTooltip()"
			@click={ "updateSelectedInstallableService('" + installableServiceEntity.Name.String() + "')" }
			class="bg-os-500 hover:ring-infinite-500 hover:text-infinite-500 group flex cursor-pointer flex-col items-center justify-center rounded-md p-2 transition-all duration-300 hover:ring-1"
			:class={ "{'text-infinite-500 ring-1 ring-infinite-500': selectedInstallableServiceName === '" + installableServiceEntity.Name.String() + "'}" }
		>
			<img
				alt={ installableServiceEntity.Name.String() + " Avatar" }
				class="max-w-18 m-auto rounded-md transition-all duration-300 group-hover:sepia"
				:class={ "{'sepia': selectedInstallableServiceName === '" + installableServiceEntity.Name.String() + "'}" }
				x-intersect.once={ "$el.src = '" + installableServiceEntity.AvatarUrl.String() + "'" }
				src="assets/placeholder-100x100.svg"
				x-transition
			/>
			<div class="text-wrap mt-1 break-words text-center text-xs">
				{ installableServiceEntity.Name.String() }
			</div>
			@CarouselItemHoverCard(
				installableServiceEntity.Description.String(),
				"ph-memory",
				installableServiceEntity.EstimatedSizeBytes.StringWithSuffix(),
			)
		</div>
	</div>
}

func transformInstallableServicesIntoCarouselItems(
	installableServices []entity.InstallableService,
) []templ.Component {
	carouselItems := []templ.Component{}
	for _, itemEntity := range installableServices {
		carouselItem := InstallableServiceItemsCarousel(itemEntity)
		carouselItems = append(carouselItems, carouselItem)
	}

	return carouselItems
}

templ ServiceAutomaticSettings() {
	<div class="grid grid-cols-3 place-items-center gap-2">
		@uiForm.ToggleSwitch(uiForm.ToggleSwitchSettings{
			Label:                       "Auto Restart",
			TwoWayStatePath:             "service.autoRestart",
			InputName:                   "autoRestart",
			TrackBackgroundColor:        "os-100",
			TrackCheckedBackgroundColor: "infinite-500",
		})
		@uiForm.ToggleSwitch(uiForm.ToggleSwitchSettings{
			Label:                       "Auto Start",
			TwoWayStatePath:             "service.autoStart",
			InputName:                   "autoStart",
			TrackBackgroundColor:        "os-100",
			TrackCheckedBackgroundColor: "infinite-500",
		})
		@uiForm.ToggleSwitch(uiForm.ToggleSwitchSettings{
			Label:                       "Auto Create Mapping",
			TwoWayStatePath:             "service.autoCreateMapping",
			InputName:                   "autoCreateMapping",
			TrackBackgroundColor:        "os-100",
			TrackCheckedBackgroundColor: "infinite-500",
		})
	</div>
}

templ InstallableServiceAdvancedSettings(
	installableServices *InstallableServicesGroupedByType,
) {
	<div class="flex w-full flex-col gap-4">
		<template
			x-if={ strconv.FormatBool(installableServices == nil) + " || selectedInstallableServiceName !== ''" }
		>
			<div class="grid grid-rows-2 gap-2">
				<div class="grid grid-cols-2 gap-2">
					@uiForm.InputField(uiForm.InputFieldSettings{
						InputType:       uiForm.InputTypeNumber,
						InputName:       "timeoutStartSecs",
						Label:           "Timeout Start Secs",
						TwoWayStatePath: "service.timeoutStartSecs",
						InputNumberMin:  "0",
					})
					@uiForm.InputField(uiForm.InputFieldSettings{
						InputType:       uiForm.InputTypeNumber,
						InputName:       "maxStartRetries",
						Label:           "Max Start Retries",
						TwoWayStatePath: "service.maxStartRetries",
						InputNumberMin:  "0",
					})
				</div>
				@ServiceAutomaticSettings()
			</div>
		</template>
		@componentForm.MultiColumnRepeatableFieldset(
			"envs", "Environment Variables", "", "service.envs",
			[]componentForm.RepeatableField{
				{InputType: "text", Id: "name", Label: "Name"},
				{InputType: "text", Id: "value", Label: "Value"},
			},
		)
		@componentForm.MultiColumnRepeatableFieldset(
			"portBindings", "Port Bindings", "",
			"service.portBindings", []componentForm.RepeatableField{
				{InputType: "text", Id: "port", Label: "Public Port"},
				{
					InputType: "select",
					Id:        "protocol",
					Label:     "Protocol",
					Options:   valueObject.ValidNetworkProtocols,
				},
			},
		)
	</div>
}

templ InstallableServiceForm(
	submitButtonId, submitButtonText, submitButtonIcon, submitButtonOnClick string,
	installableServices *InstallableServicesGroupedByType,
) {
	<!-- InstallableServiceForm -->
	if installableServices != nil {
		<div class="bg-neutral-950/20 flex flex-col gap-4 rounded-md p-3">
			<div class="flex justify-center gap-4">
				for _, serviceType := range valueObject.ValidServiceTypes {
					if serviceType != "system" {
						@uiForm.RadioInput(uiForm.RadioInputSettings{
							Label:           serviceType,
							StateValue:      serviceType,
							TwoWayStatePath: "selectedInstallableServiceType",
							InputId:         serviceType + "-service-type",
							InputName:       "selectedInstallableServiceType",
						})
					}
				}
			</div>
			<!-- InstallableServicesCarousel -->
			<div class="bg-os-400 flex w-full justify-center rounded-lg p-4">
				<div x-show="selectedInstallableServiceType === 'runtime'">
					@componentMisc.MultiItemCarousel(
						"installableRuntimeLiaisonsCarousel",
						transformInstallableServicesIntoCarouselItems(installableServices.Runtime),
						7,
					)
				</div>
				<div x-show="selectedInstallableServiceType === 'database'">
					@componentMisc.MultiItemCarousel(
						"installableDatabaseServicesCarousel",
						transformInstallableServicesIntoCarouselItems(installableServices.Database),
						7,
					)
				</div>
				<div x-show="selectedInstallableServiceType === 'webserver'">
					@componentMisc.MultiItemCarousel(
						"installableWebserverServicesCarousel",
						transformInstallableServicesIntoCarouselItems(installableServices.Webserver),
						7,
					)
				</div>
				<div x-show="selectedInstallableServiceType === 'other'">
					@componentMisc.MultiItemCarousel(
						"installableOtherServicesCarousel",
						transformInstallableServicesIntoCarouselItems(installableServices.Other),
						7,
					)
				</div>
			</div>
			<template
				x-if={ strconv.FormatBool(installableServices == nil) + " || selectedInstallableServiceName !== ''" }
			>
				@componentForm.SelectInputClientSide(componentForm.SelectInputClientSideDto{
					BindLabel:     "'Version'",
					BindModelPath: "service.version",
					BindOptions:   "selectedInstallableServiceAvailableVersions",
				})
			</template>
		</div>
	}
	<div class="my-4">
		@uiDisplay.Accordion(uiDisplay.AccordionSettings{
			Items: []uiDisplay.AccordionItemSettings{
				{
					Title:   "Advanced Settings",
					Icon:    "ph-gear",
					Content: InstallableServiceAdvancedSettings(installableServices),
				},
			},
			BackgroundColor:        "neutral-950/20",
			OpenBackgroundColor:    "neutral-950/30",
			ContentBackgroundColor: "os-400",
		})
	</div>
	@uiControl.Button(uiControl.ButtonSettings{
		Label:                submitButtonText,
		IconLeft:             submitButtonIcon,
		Id:                   submitButtonId,
		BackgroundColor:      "infinite-500",
		BackgroundColorHover: "infinite-300",
		IsFullWidth:          true,
		IsSubmit:             true,
		OnClickFunc:          submitButtonOnClick,
	})
}

templ CustomServiceAdvancedSettings() {
