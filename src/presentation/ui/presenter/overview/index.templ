				InputNumberMin:  "0",
			})
			@uiForm.InputField(uiForm.InputFieldSettings{
				InputType:       uiForm.InputTypeNumber,
				InputName:       "maxStartRetries",
				Label:           "Max Start Retries",
				TwoWayStatePath: "service.maxStartRetries",
				InputNumberMin:  "0",
			})
		</div>
		<div class="grid grid-cols-2 gap-2">
			@uiForm.InputField(uiForm.InputFieldSettings{
				InputType:                         uiForm.InputTypeText,
				InputName:                         "logOutputPath",
				Label:                             "Log Output Path",
				TwoWayStatePath:                   "service.logOutputPath",
				HintValue:                         "Path to the file that will receive the custom service output logs.",
				HintDisplay:                       uiForm.InputHintDisplayTooltip,
				HintDisplayTooltipBackgroundColor: "os-400",
			})
			@uiForm.InputField(uiForm.InputFieldSettings{
				InputType:                         uiForm.InputTypeText,
				InputName:                         "logErrorPath",
				Label:                             "Log Error Path",
				TwoWayStatePath:                   "service.logErrorPath",
				HintValue:                         "Path to the file that will receive the custom service error logs.",
				HintDisplay:                       uiForm.InputHintDisplayTooltip,
				HintDisplayTooltipBackgroundColor: "os-400",
			})
		</div>
		@ServiceAutomaticSettings()
		@componentForm.MultiColumnRepeatableFieldset(
			"envs", "Environment Variables", "", "service.envs",
			[]componentForm.RepeatableField{
				{InputType: "text", Id: "name", Label: "Name"},
				{InputType: "text", Id: "value", Label: "Value"},
			},
		)
		@componentForm.MultiColumnRepeatableFieldset(
			"portBindings", "Port Bindings", "",
			"service.portBindings", []componentForm.RepeatableField{
				{InputType: "text", Id: "port", Label: "Public Port"},
				{
					InputType: "select",
					Id:        "protocol",
					Label:     "Protocol",
					Options:   valueObject.ValidNetworkProtocols,
				},
			},
		)
	</div>
}

templ CustomServiceForm(
	submitButtonId, submitButtonText, submitButtonIcon, submitButtonOnClick string,
) {
	<!-- CustomServiceForm -->
	<div class="grid grid-rows-2 gap-4">
		<div class="grid grid-cols-2 gap-x-2">
			@uiForm.InputField(uiForm.InputFieldSettings{
				InputType:       uiForm.InputTypeText,
				InputName:       "name",
				Label:           "Name",
				TwoWayStatePath: "service.name",
			})
			@uiForm.SelectInput(uiForm.SelectInputSettings{
				InputName:                "type",
				Label:                    "Type",
				FlatOptions:              valueObject.ValidServiceTypes,
				TwoWayStatePath:          "service.type",
				DropdownBackgroundColor:  "primary-500/95",
				ShouldIncludeBlankOption: true,
			})
		</div>
		<div class="flex justify-center">
			<div class="w-2/3">
				@uiForm.InputField(uiForm.InputFieldSettings{
					InputType:                         uiForm.InputTypeText,
					InputName:                         "startCmd",
					Label:                             "Start Command",
					TwoWayStatePath:                   "service.startCmd",
					HintValue:                         `Example: "/usr/bin/binary". If you need to install multiple packages to run your software, you must use the Terminal (SSH).`,
					HintDisplay:                       uiForm.InputHintDisplayTooltip,
					HintDisplayTooltipBackgroundColor: "os-400",
				})
			</div>
		</div>
	</div>
	<div class="my-4">
		@uiDisplay.Accordion(uiDisplay.AccordionSettings{
			Items: []uiDisplay.AccordionItemSettings{
				{
					Title:   "Advanced Settings",
					Icon:    "ph-gear",
					Content: CustomServiceAdvancedSettings(),
				},
			},
			BackgroundColor:        "neutral-950/20",
			OpenBackgroundColor:    "neutral-950/30",
			ContentBackgroundColor: "os-400",
		})
	</div>
	@uiControl.Button(uiControl.ButtonSettings{
		Label:                submitButtonText,
		IconLeft:             submitButtonIcon,
		Id:                   submitButtonId,
		BackgroundColor:      "infinite-500",
		BackgroundColorHover: "infinite-300",
		IsFullWidth:          true,
		IsSubmit:             true,
		OnClickFunc:          submitButtonOnClick,
	})
}

templ ServiceInstallationForm(installableServices InstallableServicesGroupedByType) {
	<form @submit.prevent="">
		<div class="mb-4 flex justify-start gap-4">
			@uiForm.RadioInput(uiForm.RadioInputSettings{
				Label:           "Installable",
				StateValue:      "installables",
				TwoWayStatePath: "targetServiceType",
				InputId:         "service-installation-installables",
				InputName:       "targetServiceType",
			})
			@uiForm.RadioInput(uiForm.RadioInputSettings{
				Label:           "Custom",
				StateValue:      "custom",
				TwoWayStatePath: "targetServiceType",
				InputId:         "service-installation-custom",
				InputName:       "targetServiceType",
			})
		</div>
		<div x-show="targetServiceType === 'installables'">
			@InstallableServiceForm(
				"schedule-service-installation-button", "schedule installation",
				"ph-queue", "installService()", &installableServices,
			)
		</div>
		<div x-show="targetServiceType === 'custom'">
			@CustomServiceForm(
				"install-service-button", "install immediately", "ph-arrow-line-down",
				"installService()",
			)
		</div>
	</form>
}

templ ServiceInstallationModal(
	installableServices InstallableServicesGroupedByType,
) {
	@uiDisplay.Modal(uiDisplay.ModalSettings{
		MiddleContent:            ServiceInstallationForm(installableServices),
		Title:                    "Install Service",
		BackgroundColor:          "os-400",
		ShouldHeightMatchContent: true,
		IsVisibleTwoWayStatePath: "isServiceInstallationModalOpen",
		OnCloseFunc:              "closeServiceInstallationModal()",
	})
}

templ UpdateInstalledServiceForm() {
	<form @submit.prevent="">
		<div x-show="service.nature !== 'custom'">
			@InstallableServiceForm(
				"update-installed-service-button", "update service", "ph-check-fat",
				"updateService()", nil,
			)
		</div>
		<div class="pt-3" x-show="service.nature === 'custom'">
			@CustomServiceForm(
				"update-installed-service-button", "update service", "ph-check-fat",
				"updateService()",
			)
		</div>
	</form>
}

templ UpdateInstalledServiceModal() {
	@uiDisplay.Modal(uiDisplay.ModalSettings{
		MiddleContent:            UpdateInstalledServiceForm(),
		TitleOneWayStatePath:     "'Update Service #' + service.name",
		BackgroundColor:          "os-400",
		ShouldHeightMatchContent: true,
		IsVisibleTwoWayStatePath: "isUpdateInstalledServiceModalOpen",
		OnCloseFunc:              "closeUpdateInstalledServiceModal()",
	})
}
