package uiLayout

import (
	_ "embed"
	layoutFooter "github.com/goinfinite/os/src/presentation/ui/layout/footer"
	layoutSidebar "github.com/goinfinite/os/src/presentation/ui/layout/sidebar"
	infraHelper "github.com/goinfinite/os/src/infra/helper"
	"github.com/goinfinite/ui/src/display"
	uiImport "github.com/goinfinite/ui/src/import"
	"github.com/goinfinite/ui/src/toolset"
)

templ HeadTag(baseHref string) {
	<head>
		<meta charset="utf-8"/>
		<base href={ baseHref }/>
		<meta name="robots" content="noindex"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests"/>
		<title>Infinite OS</title>
		<link rel="icon" type="image/ico" href="assets/favicon.ico"/>
		<script src="assets/additional.js"></script>
		@uiImport.HeadTagsFull()
		<link rel="stylesheet" type="text/css" href="assets/additional.css"/>
		@uiImport.HeadTagsVega()
	</head>
}

type MainLayoutSettings struct {
	BaseHref    string
	PageContent templ.Component
}

//go:embed state.js
var mainLayoutAlpineState string

templ scheduledTaskCompletedBannerContent() {
	<div class="flex w-full items-center justify-between gap-4">
		<span>A Scheduled Task was just completed. The state of this page is likely outdated.</span>
		<button
			type="button"
			@click="$store.main.refreshPageContent()"
			class="bg-infinite-500 hover:bg-infinite-300 shrink-0 cursor-pointer rounded-md border-none px-2 py-1 text-sm font-bold lowercase text-white transition-colors"
		>
			Refresh Page Content
		</button>
	</div>
}

templ ScheduledTaskCompletedBanner() {
	<div
		x-data
		style="display: none"
		x-show="$store.main.displayScheduledTaskCompletedBanner"
		x-transition
		class="fixed top-4 left-1/2 z-100 w-full max-w-3xl -translate-x-1/2 px-4"
	>
		@uiDisplay.Alert(uiDisplay.AlertSettings{
			Variation:       uiDisplay.AlertVariationSuccess,
			BackgroundColor: "emerald-800",
			TextColor:       "neutral-50",
			Size:            uiDisplay.AlertSizeSm,
			ShadowSize:      uiDisplay.AlertShadowSizeLg,
			ContentHtml:     scheduledTaskCompletedBannerContent(),
		})
	</div>
}

templ TerminalSessionsModal() {
	<div
		x-data
		x-cloak
		x-show="$store.main.isTerminalSessionsModalOpen"
		x-transition:enter="transition ease-out duration-300"
		x-transition:enter-start="opacity-0"
		x-transition:enter-end="opacity-100"
		x-transition:leave="transition ease-in duration-150"
		x-transition:leave-start="opacity-100"
		x-transition:leave-end="opacity-0"
		class="fixed left-0 top-0 z-60 mx-auto h-screen max-h-screen w-full overflow-y-auto overflow-x-hidden bg-neutral-950 bg-opacity-50"
	>
		<div class="bg-os-400 relative mx-auto mt-20 max-w-3/5 rounded-md p-6 drop-shadow-xl xl:mt-24 xl:max-w-3xl">
			<div class="mb-6 flex justify-between align-middle">
				<h2 class="text-2xl">Terminal Sessions</h2>
				<button
					id="terminal-sessions-modal-close"
					type="button"
					@click="$store.main.closeTerminalSessionsModal()"
					class="bg-os-200 hover:bg-os-100 rounded-md border-none px-2 py-1 text-neutral-50"
				>
					<i class="ph-bold ph-x align-middle text-xl"></i>
				</button>
			</div>
			<div id="terminal-sessions-modal-body"></div>
		</div>
	</div>
}

templ Main(componentSettings MainLayoutSettings) {
	<!DOCTYPE html>
	<html>
		@HeadTag(componentSettings.BaseHref)
		<!-- MainLayout JavaScript -->
		@uiToolset.MinifierTemplateJs(&mainLayoutAlpineState)
		if infraHelper.IsDevMode() {
			@templ.JSFuncCall("devWsHotReload")
		}
		<!-- MainLayout HTML -->
		<body class="bg-primary-500 flex overflow-hidden text-neutral-50">
			@uiDisplay.CloakLoading(uiDisplay.CloakLoadingSettings{})
			@uiDisplay.LoadingOverlay(uiDisplay.LoadingOverlaySettings{})
			@layoutSidebar.Sidebar(componentSettings.BaseHref)
			<!-- PageContent -->
			<section id="page-content" class="h-screen w-full overflow-y-auto overflow-x-hidden p-6">
				@componentSettings.PageContent
			</section>
			@ScheduledTaskCompletedBanner()
			@TerminalSessionsModal()
			@layoutFooter.FooterSkeleton()
			@uiDisplay.Toast(uiDisplay.ToastSettings{})
		</body>
	</html>
}
